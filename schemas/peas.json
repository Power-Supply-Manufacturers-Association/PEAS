{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://psma.com/peas/peas.json",
    "title": "PEAS",
    "description": "Power Electronics Agnostic Structure — Universal container for any electronic component. A valid MAS / CAS / SAS / RAS / controller / connector document is also a valid PEAS.",
    "type": "object",
    "required": [
        "inputs"
    ],
    "properties": {
        "inputs": {
            "description": "Per-component design requirements and operating points. `designRequirements` is ALWAYS required — it is the ideal-simulation seed that the librarian uses to bind a real part and that is retained post-binding as the spec the part met. Its concrete shape is pinned to the discriminator branch (magnetic/capacitor/semiconductor/resistor/controller/connector) by the if/then clauses at the bottom of this schema.",
            "type": "object",
            "additionalProperties": false,
            "required": [
                "designRequirements"
            ],
            "properties": {
                "designRequirements": {
                    "description": "Family-specific design-requirements seed. The if/then clauses below pin this to the matching family schema based on which discriminator branch (magnetic/capacitor/semiconductor/resistor/controller/connector) is populated.",
                    "oneOf": [
                        {
                            "$ref": "https://psma.com/mas/inputs/designRequirements.json"
                        },
                        {
                            "$ref": "https://psma.com/cas/inputs/designRequirements.json"
                        },
                        {
                            "$ref": "https://psma.com/sas/inputs/designRequirements.json"
                        },
                        {
                            "$ref": "https://psma.com/ras/inputs/designRequirements.json"
                        },
                        {
                            "$ref": "https://psma.com/ctas/inputs/designRequirements.json"
                        },
                        {
                            "$ref": "https://psma.com/conas/inputs/designRequirements.json"
                        }
                    ]
                },
                "operatingPoints": {
                    "description": "Operating points the component must satisfy. Shape is fixed by the sibling family schema (e.g. MAS inputs/operatingPoint).",
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": true
                    }
                }
            }
        },
        "outputs": {
            "description": "Computed results (losses, thermal, impedance, etc.). May be a single object or an array of per-operating-point results; concrete shape is fixed by the sibling family schema.",
            "oneOf": [
                {
                    "type": "object",
                    "additionalProperties": true
                },
                {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": true
                    }
                }
            ]
        }
    },
    "oneOf": [
        {
            "description": "Magnetic component (inductor, transformer, choke) — defined by MAS.",
            "properties": {
                "magnetic": {
                    "$ref": "https://psma.com/mas/magnetic.json"
                }
            },
            "required": [
                "magnetic"
            ]
        },
        {
            "description": "Capacitor — defined by CAS.",
            "properties": {
                "capacitor": {
                    "$ref": "https://psma.com/cas/capacitor.json"
                }
            },
            "required": [
                "capacitor"
            ]
        },
        {
            "description": "Semiconductor (MOSFET, diode, IGBT, BJT) — defined by SAS.",
            "properties": {
                "semiconductor": {
                    "$ref": "https://psma.com/sas/SAS.json"
                }
            },
            "required": [
                "semiconductor"
            ]
        },
        {
            "description": "Resistor — defined by RAS.",
            "properties": {
                "resistor": {
                    "$ref": "https://psma.com/ras/resistor.json"
                }
            },
            "required": [
                "resistor"
            ]
        },
        {
            "description": "Control IC (PWM / multiphase / LLC / PFC / phase-shift / sync-rectifier / digital / gate-driver / shunt-regulator / voltage-reference / current-sense / isolated amplifier / hot-swap / eFuse) — defined by CTAS. Extracted from the former inline PEAS branch into the CTAS sibling repo; CTAS owns the controller-family enums while reusing the PEAS shared primitives.",
            "properties": {
                "controller": {
                    "$ref": "https://psma.com/ctas/controller.json"
                }
            },
            "required": [
                "controller"
            ]
        },
        {
            "description": "Connector — defined by CONAS. Covers the full range of board-boundary conductors: screw terminals (terminalBlock), solder pads, pin headers, edge-card, wire-to-board, RF, power, etc. A minimal Tier-1-only CONAS doc (connector: {}) with inputs.designRequirements (connectorFamily + electrical ratings) is valid for pre-librarian abstract-boundary seeds; manufacturerInfo is populated after librarian binding.",
            "properties": {
                "connector": {
                    "$ref": "https://psma.com/conas/connector.json"
                }
            },
            "required": [
                "connector"
            ]
        }
    ],
    "allOf": [
        {
            "$comment": "Pin inputs.designRequirements shape to the populated discriminator branch.",
            "if": {
                "required": [
                    "magnetic"
                ]
            },
            "then": {
                "properties": {
                    "inputs": {
                        "properties": {
                            "designRequirements": {
                                "$ref": "https://psma.com/mas/inputs/designRequirements.json"
                            }
                        }
                    }
                }
            }
        },
        {
            "if": {
                "required": [
                    "capacitor"
                ]
            },
            "then": {
                "properties": {
                    "inputs": {
                        "properties": {
                            "designRequirements": {
                                "$ref": "https://psma.com/cas/inputs/designRequirements.json"
                            }
                        }
                    }
                }
            }
        },
        {
            "if": {
                "required": [
                    "semiconductor"
                ]
            },
            "then": {
                "properties": {
                    "inputs": {
                        "properties": {
                            "designRequirements": {
                                "$ref": "https://psma.com/sas/inputs/designRequirements.json"
                            }
                        }
                    }
                }
            }
        },
        {
            "if": {
                "required": [
                    "resistor"
                ]
            },
            "then": {
                "properties": {
                    "inputs": {
                        "properties": {
                            "designRequirements": {
                                "$ref": "https://psma.com/ras/inputs/designRequirements.json"
                            }
                        }
                    }
                }
            }
        },
        {
            "if": {
                "required": [
                    "controller"
                ]
            },
            "then": {
                "properties": {
                    "inputs": {
                        "properties": {
                            "designRequirements": {
                                "$ref": "https://psma.com/ctas/inputs/designRequirements.json"
                            }
                        }
                    }
                }
            }
        },
        {
            "if": {
                "required": [
                    "connector"
                ]
            },
            "then": {
                "properties": {
                    "inputs": {
                        "properties": {
                            "designRequirements": {
                                "$ref": "https://psma.com/conas/inputs/designRequirements.json"
                            }
                        }
                    }
                }
            }
        }
    ]
}
