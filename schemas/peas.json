{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "http://openconverters.com/schemas/PEAS/peas.json",
    "title": "PEAS",
    "description": "Power Electronics Agnostic Structure — Universal container for any electronic component. A valid MAS / CAS / SAS / RAS / controller document is also a valid PEAS.",
    "type": "object",
    "required": ["inputs"],
    "properties": {
        "inputs": {
            "description": "Per-component design requirements and operating points. `designRequirements` is ALWAYS required — it is the ideal-simulation seed that the librarian uses to bind a real part and that is retained post-binding as the spec the part met. Its concrete shape is pinned to the discriminator branch (magnetic/capacitor/semiconductor/resistor/controller) by the if/then clauses at the bottom of this schema.",
            "type": "object",
            "additionalProperties": false,
            "required": ["designRequirements"],
            "properties": {
                "designRequirements": {
                    "description": "Family-specific design-requirements seed. The if/then clauses below pin this to the matching family schema based on which discriminator branch (magnetic/capacitor/semiconductor/resistor/controller) is populated.",
                    "oneOf": [
                        { "$ref": "../../MAS/schemas/inputs/designRequirements.json" },
                        { "$ref": "../../CAS/schemas/inputs/designRequirements.json" },
                        { "$ref": "../../SAS/schemas/inputs/designRequirements.json" },
                        { "$ref": "../../RAS/schemas/inputs/designRequirements.json" },
                        { "$ref": "./controller.json#/$defs/designRequirements" }
                    ]
                },
                "operatingPoints": {
                    "description": "Operating points the component must satisfy. Shape is fixed by the sibling family schema (e.g. MAS inputs/operatingPoint).",
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": true
                    }
                }
            }
        },
        "outputs": {
            "description": "Computed results (losses, thermal, impedance, etc.). May be a single object or an array of per-operating-point results; concrete shape is fixed by the sibling family schema.",
            "oneOf": [
                {
                    "type": "object",
                    "additionalProperties": true
                },
                {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": true
                    }
                }
            ]
        }
    },
    "oneOf": [
        {
            "description": "Magnetic component (inductor, transformer, choke) — defined by MAS.",
            "properties": {
                "magnetic": { "$ref": "http://openmagnetics.com/schemas/magnetic.json" }
            },
            "required": ["magnetic"]
        },
        {
            "description": "Capacitor — defined by CAS.",
            "properties": {
                "capacitor": { "$ref": "../../CAS/schemas/capacitor.json" }
            },
            "required": ["capacitor"]
        },
        {
            "description": "Semiconductor (MOSFET, diode, IGBT, BJT) — defined by SAS.",
            "properties": {
                "semiconductor": { "$ref": "../../SAS/schemas/SAS.json" }
            },
            "required": ["semiconductor"]
        },
        {
            "description": "Resistor — defined by RAS.",
            "properties": {
                "resistor": { "$ref": "../../RAS/schemas/resistor.json" }
            },
            "required": ["resistor"]
        },
        {
            "description": "Control IC (PWM / LLC / PFC / digital / gate-driver / voltage-reference / current-sense / opto-feedback / isolated amplifier / hot-swap). Inline PEAS branch today; candidate for extraction to a CtAS sibling repo once the schema has settled.",
            "properties": {
                "controller": { "$ref": "./controller.json#/properties/controller" }
            },
            "required": ["controller"]
        }
    ],
    "allOf": [
        {
            "$comment": "Pin inputs.designRequirements shape to the populated discriminator branch.",
            "if":   { "required": ["magnetic"] },
            "then": { "properties": { "inputs": { "properties": { "designRequirements": { "$ref": "../../MAS/schemas/inputs/designRequirements.json" } } } } }
        },
        {
            "if":   { "required": ["capacitor"] },
            "then": { "properties": { "inputs": { "properties": { "designRequirements": { "$ref": "../../CAS/schemas/inputs/designRequirements.json" } } } } }
        },
        {
            "if":   { "required": ["semiconductor"] },
            "then": { "properties": { "inputs": { "properties": { "designRequirements": { "$ref": "../../SAS/schemas/inputs/designRequirements.json" } } } } }
        },
        {
            "if":   { "required": ["resistor"] },
            "then": { "properties": { "inputs": { "properties": { "designRequirements": { "$ref": "../../RAS/schemas/inputs/designRequirements.json" } } } } }
        },
        {
            "if":   { "required": ["controller"] },
            "then": { "properties": { "inputs": { "properties": { "designRequirements": { "$ref": "./controller.json#/$defs/designRequirements" } } } } }
        }
    ]
}
