{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://psma.com/peas/peas.json",
    "title": "PEAS",
    "description": "Power Electronics Agnostic Structure — Universal container for any electronic component. A valid MAS / CAS / SAS / RAS / controller / connector document is also a valid PEAS.",
    "type": "object",
    "required": [
        "inputs"
    ],
    "properties": {
        "inputs": {
            "description": "Per-component design requirements and operating points. `designRequirements` is ALWAYS required — it is the ideal-simulation seed that the librarian uses to bind a real part and that is retained post-binding as the spec the part met. Its concrete shape is pinned to the discriminator branch (magnetic/capacitor/semiconductor/resistor/controller/terminal/connector) by the if/then clauses at the bottom of this schema.",
            "type": "object",
            "additionalProperties": false,
            "required": [
                "designRequirements"
            ],
            "properties": {
                "designRequirements": {
                    "description": "Family-specific design-requirements seed. The if/then clauses below pin this to the matching family schema based on which discriminator branch (magnetic/capacitor/semiconductor/resistor/controller/terminal/connector) is populated.",
                    "oneOf": [
                        {
                            "$ref": "https://psma.com/mas/inputs/designRequirements.json"
                        },
                        {
                            "$ref": "https://psma.com/cas/inputs/designRequirements.json"
                        },
                        {
                            "$ref": "https://psma.com/sas/inputs/designRequirements.json"
                        },
                        {
                            "$ref": "https://psma.com/ras/inputs/designRequirements.json"
                        },
                        {
                            "$ref": "./controller.json#/$defs/designRequirements"
                        },
                        {
                            "$ref": "./terminal.json#/$defs/designRequirements"
                        },
                        {
                            "$ref": "https://psma.com/conas/inputs/designRequirements.json"
                        }
                    ]
                },
                "operatingPoints": {
                    "description": "Operating points the component must satisfy. Shape is fixed by the sibling family schema (e.g. MAS inputs/operatingPoint).",
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": true
                    }
                }
            }
        },
        "outputs": {
            "description": "Computed results (losses, thermal, impedance, etc.). May be a single object or an array of per-operating-point results; concrete shape is fixed by the sibling family schema.",
            "oneOf": [
                {
                    "type": "object",
                    "additionalProperties": true
                },
                {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": true
                    }
                }
            ]
        }
    },
    "oneOf": [
        {
            "description": "Magnetic component (inductor, transformer, choke) — defined by MAS.",
            "properties": {
                "magnetic": {
                    "$ref": "https://psma.com/mas/magnetic.json"
                }
            },
            "required": [
                "magnetic"
            ]
        },
        {
            "description": "Capacitor — defined by CAS.",
            "properties": {
                "capacitor": {
                    "$ref": "https://psma.com/cas/capacitor.json"
                }
            },
            "required": [
                "capacitor"
            ]
        },
        {
            "description": "Semiconductor (MOSFET, diode, IGBT, BJT) — defined by SAS.",
            "properties": {
                "semiconductor": {
                    "$ref": "https://psma.com/sas/SAS.json"
                }
            },
            "required": [
                "semiconductor"
            ]
        },
        {
            "description": "Resistor — defined by RAS.",
            "properties": {
                "resistor": {
                    "$ref": "https://psma.com/ras/resistor.json"
                }
            },
            "required": [
                "resistor"
            ]
        },
        {
            "description": "Control IC (PWM / LLC / PFC / digital / gate-driver / voltage-reference / current-sense / opto-feedback / isolated amplifier / hot-swap). Inline PEAS branch today; candidate for extraction to a CtAS sibling repo once the schema has settled.",
            "properties": {
                "controller": {
                    "$ref": "./controller.json#/properties/controller"
                }
            },
            "required": [
                "controller"
            ]
        },
        {
            "description": "Board terminal (screw terminal, solder pad, header, edge-card finger, connector). Inline PEAS branch today; first-class because every wire that crosses the converter boundary terminates at a real terminal with measurable resistance, current rating, and thermal mass.",
            "properties": {
                "terminal": {
                    "$ref": "./terminal.json#/properties/terminal"
                }
            },
            "required": [
                "terminal"
            ]
        },
        {
            "description": "Connector — defined by CONAS. Coexists with the lightweight 'terminal' branch: terminal is the abstract board-boundary point, connector is the physical orderable part.",
            "properties": {
                "connector": {
                    "$ref": "https://psma.com/conas/connector.json"
                }
            },
            "required": [
                "connector"
            ]
        }
    ],
    "allOf": [
        {
            "$comment": "Pin inputs.designRequirements shape to the populated discriminator branch.",
            "if": {
                "required": [
                    "magnetic"
                ]
            },
            "then": {
                "properties": {
                    "inputs": {
                        "properties": {
                            "designRequirements": {
                                "$ref": "https://psma.com/mas/inputs/designRequirements.json"
                            }
                        }
                    }
                }
            }
        },
        {
            "if": {
                "required": [
                    "capacitor"
                ]
            },
            "then": {
                "properties": {
                    "inputs": {
                        "properties": {
                            "designRequirements": {
                                "$ref": "https://psma.com/cas/inputs/designRequirements.json"
                            }
                        }
                    }
                }
            }
        },
        {
            "if": {
                "required": [
                    "semiconductor"
                ]
            },
            "then": {
                "properties": {
                    "inputs": {
                        "properties": {
                            "designRequirements": {
                                "$ref": "https://psma.com/sas/inputs/designRequirements.json"
                            }
                        }
                    }
                }
            }
        },
        {
            "if": {
                "required": [
                    "resistor"
                ]
            },
            "then": {
                "properties": {
                    "inputs": {
                        "properties": {
                            "designRequirements": {
                                "$ref": "https://psma.com/ras/inputs/designRequirements.json"
                            }
                        }
                    }
                }
            }
        },
        {
            "if": {
                "required": [
                    "controller"
                ]
            },
            "then": {
                "properties": {
                    "inputs": {
                        "properties": {
                            "designRequirements": {
                                "$ref": "./controller.json#/$defs/designRequirements"
                            }
                        }
                    }
                }
            }
        },
        {
            "if": {
                "required": [
                    "terminal"
                ]
            },
            "then": {
                "properties": {
                    "inputs": {
                        "properties": {
                            "designRequirements": {
                                "$ref": "./terminal.json#/$defs/designRequirements"
                            }
                        }
                    }
                }
            }
        },
        {
            "if": {
                "required": [
                    "connector"
                ]
            },
            "then": {
                "properties": {
                    "inputs": {
                        "properties": {
                            "designRequirements": {
                                "$ref": "https://psma.com/conas/inputs/designRequirements.json"
                            }
                        }
                    }
                }
            }
        }
    ]
}
