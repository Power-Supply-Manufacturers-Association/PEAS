{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "http://openconverters.com/schemas/EAS/utils.json",
    "title": "EAS utils",
    "description": "Shared primitives and datasheetInfo building blocks for CAS, RAS, and SAS. MAS remains self-contained and does not reference this file.",
    "type": "object",
    "$defs": {
        "dimensionWithTolerance": {
            "description": "A dimension with minimum, nominal, and maximum values.",
            "type": "object",
            "properties": {
                "minimum": {
                    "description": "The minimum value of the dimension.",
                    "type": "number"
                },
                "nominal": {
                    "description": "The nominal value of the dimension.",
                    "type": "number"
                },
                "maximum": {
                    "description": "The maximum value of the dimension.",
                    "type": "number"
                }
            },
            "anyOf": [
                {"required": ["minimum"]},
                {"required": ["nominal"]},
                {"required": ["maximum"]}
            ]
        },
        "curve": {
            "type": "object",
            "description": "X-Y curve data points.",
            "additionalProperties": false,
            "properties": {
                "xData": {
                    "description": "X-axis values.",
                    "$ref": "#/$defs/numberArray"
                },
                "yData": {
                    "description": "Y-axis values.",
                    "$ref": "#/$defs/numberArray"
                }
            }
        },
        "numberArray": {
            "type": "array",
            "description": "Array of numeric values.",
            "items": {
                "type": "number"
            }
        },
        "connectionType": {
            "description": "PCB / terminal connection type.",
            "type": "string",
            "enum": ["Pin", "Screw", "SMT", "Flying Lead", "THT", "Chassis"]
        },
        "distributorInfo": {
            "description": "Where to buy this component.",
            "type": "object",
            "properties": {
                "name": { "type": "string", "description": "Distributor name (e.g. Digi-Key, Mouser)." },
                "reference": { "type": ["string", "null"], "description": "Distributor part number." },
                "link": { "type": ["string", "null"], "format": "uri", "description": "Product page URL." },
                "cost": { "type": ["number", "null"], "description": "Unit cost in USD." },
                "stock": { "type": ["integer", "null"], "description": "Available stock quantity." },
                "country": { "type": ["string", "null"], "description": "Country of distribution." }
            },
            "required": ["name"]
        },
        "substituteInfo": {
            "description": "A substitute or equivalent component that can replace this one.",
            "type": "object",
            "properties": {
                "partNumber": { "type": "string", "description": "Part number of the substitute." },
                "manufacturer": { "type": ["string", "null"], "description": "Manufacturer of the substitute." },
                "type": {
                    "type": "string",
                    "description": "Type of substitution.",
                    "enum": ["drop-in", "near-equivalent", "functional", "upgrade", "downgrade", "successor"]
                },
                "notes": { "type": ["string", "null"], "description": "Differences or caveats." },
                "source": {
                    "type": ["string", "null"],
                    "description": "Where this substitution was identified.",
                    "enum": ["manufacturer", "distributor", "cross-reference", "engineering", null]
                }
            },
            "required": ["partNumber"]
        },
        "datasheetInfoThermal": {
            "description": "Shared thermal section for datasheetInfo: operating temperature as dimensionWithTolerance (minimum = min operating, maximum = max operating).",
            "type": "object",
            "properties": {
                "operatingTemperature": {
                    "description": "Operating temperature range in degrees Celsius.",
                    "$ref": "#/$defs/dimensionWithTolerance"
                }
            }
        },
        "datasheetInfoMechanical": {
            "description": "Shared mechanical section for datasheetInfo: named dimensions as dimensionWithTolerance and connection type.",
            "type": "object",
            "properties": {
                "length": {
                    "description": "Body length in metres.",
                    "$ref": "#/$defs/dimensionWithTolerance"
                },
                "width": {
                    "description": "Body width in metres.",
                    "$ref": "#/$defs/dimensionWithTolerance"
                },
                "height": {
                    "description": "Body height in metres.",
                    "$ref": "#/$defs/dimensionWithTolerance"
                },
                "diameter": {
                    "description": "Body diameter in metres (for cylindrical parts).",
                    "$ref": "#/$defs/dimensionWithTolerance"
                },
                "assemblyType": {
                    "description": "PCB mounting / assembly type.",
                    "$ref": "#/$defs/connectionType"
                }
            }
        },
        "datasheetInfoBusiness": {
            "description": "Shared business / supply-chain section for datasheetInfo.",
            "type": "object",
            "properties": {
                "packaging": { "type": ["string", "null"], "description": "Packaging format (e.g. Tape & Reel, Bulk, Tray)." },
                "vpe": { "type": ["integer", "null"], "description": "Units per package / reel." },
                "moq": { "type": ["integer", "null"], "description": "Minimum order quantity." },
                "leadTime": { "type": ["number", "null"], "description": "Lead time in weeks." },
                "stock": { "type": ["integer", "null"], "description": "Available stock quantity." },
                "cost": { "type": ["number", "null"], "description": "Unit cost." }
            }
        }
    }
}
